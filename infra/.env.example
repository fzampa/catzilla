# Copy to infra/.env (git-ignored) and fill in. Do not commit real values.
# Host name or IP the phone uses to reach this machine.
SITE_ADDRESS=
DATABASE_USERNAME=catzilla
DATABASE_PASSWORD=
# Host port for PostgreSQL (bound to 127.0.0.1). Change it if a local Postgres already uses 5432.
# DATABASE_PORT=5432
# Optional: use an image built by CI instead of building locally
# API_IMAGE=ghcr.io/<owner>/catzilla-api:main
