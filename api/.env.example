# Local settings for running the API from an IDE or ./gradlew bootRun.
# Copy to api/.env (git-ignored) and fill in. Spring Boot loads it on startup;
# real environment variables still take precedence.

# Matches the db service in infra/compose.yaml (docker compose up -d db).
DATABASE_URL=jdbc:postgresql://localhost:5432/catzilla
DATABASE_USERNAME=catzilla
# Same value as DATABASE_PASSWORD in infra/.env
DATABASE_PASSWORD=

# Browser origins allowed to call the API cross-origin (comma-separated).
# http://localhost:8081 is the Expo web dev server (npm run web). Add
# http://<your-mac-ip>:8081 to open the dev server from the phone's browser.
# Native apps (Expo Go, simulators) don't need this. Leave unset in deployment.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# RSA private key that signs access tokens (ADR-004), as one line of base64 PKCS#8.
# Optional locally: when empty, the API generates a temporary key at startup and
# everyone has to sign in again after each restart. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 | tr -d '\n'
# Use a different key here than in infra/.env.
JWT_PRIVATE_KEY=
